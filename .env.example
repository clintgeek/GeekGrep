# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here

# LLM Backend Selection
GEEKGREP_LLM_BACKEND=openai    # Options: 'openai' or 'ollama'
GEEKGREP_MODEL=gpt-4o-mini     # OpenAI: gpt-4o-mini, gpt-4o, etc. | Ollama: mistral, llama2, etc.

# Optional: Ollama Configuration (only needed if GEEKGREP_LLM_BACKEND=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Application Settings
GEEKGREP_DATA_DIR=./data
GEEKGREP_DOCUMENTS_DIR=./documents
GEEKGREP_LOG_LEVEL=INFO
